	Q_4C = V_4C*V_3A*Y_4C_3A*sin(delta_4C-theta_4C_3A-delta_3A) + V_4C*V_3B*Y_4C_3B*sin(delta_4C-theta_4C_3B-delta_3B) + V_4C*V_3C*Y_4C_3C*sin(delta_4C-theta_4C_3C-delta_3C) + V_4C*V_4A*Y_4C_4A*sin(delta_4C-theta_4C_4A-delta_4A) + V_4C*V_4B*Y_4C_4B*sin(delta_4C-theta_4C_4B-delta_4B) - V_4C*V_4C*Y_4C_4C*sin(theta_4C_4C)
