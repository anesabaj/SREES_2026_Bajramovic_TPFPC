	Q_4B = V_4B*V_3A*Y_4B_3A*sin(delta_4B-theta_4B_3A-delta_3A) + V_4B*V_3B*Y_4B_3B*sin(delta_4B-theta_4B_3B-delta_3B) + V_4B*V_3C*Y_4B_3C*sin(delta_4B-theta_4B_3C-delta_3C) + V_4B*V_4A*Y_4B_4A*sin(delta_4B-theta_4B_4A-delta_4A) - V_4B*V_4B*Y_4B_4B*sin(theta_4B_4B) + V_4B*V_4C*Y_4B_4C*sin(delta_4B-theta_4B_4C-delta_4C)
	// node 4C - PQ
